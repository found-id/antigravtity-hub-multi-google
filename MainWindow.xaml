<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Antigravity Hub"
        Height="680" Width="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Sleek Monochrome Dark Palette -->
        <SolidColorBrush x:Key="BgDark" Color="#0B0B0E"/>
        <SolidColorBrush x:Key="SurfaceCard" Color="#131318"/>
        <SolidColorBrush x:Key="SurfacePanel" Color="#101015"/>
        <SolidColorBrush x:Key="SurfaceInput" Color="#0D0D11"/>
        <SolidColorBrush x:Key="BorderMuted" Color="#1E1E26"/>
        <SolidColorBrush x:Key="TextMain" Color="#F4F4F6"/>
        <SolidColorBrush x:Key="TextSub" Color="#7C7C8A"/>

        <!-- Window Control Button -->
        <Style x:Key="WindowCtrlBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#7C7C8A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E1E26"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#282832"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Icon / Reorder / Rename / Browser Button -->
        <Style x:Key="MiniIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#787886"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="miniBg" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="miniBg" Property="Background" Value="#22222C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle Chip / Option Button -->
        <Style x:Key="ChipBtn" TargetType="Button">
            <Setter Property="Background" Value="#17171E"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderBrush" Value="#262632"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chipBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="#22222C"/>
                                <Setter TargetName="chipBorder" Property="BorderBrush" Value="#3E3E4E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Selected Chip Button -->
        <Style x:Key="ChipBtnSelected" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#09090B"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chipBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button (Crisp Pure White) -->
        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#09090B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E4E4EA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C8C8D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Active Button (Subtle Emerald for Fokus) -->
        <Style x:Key="ActiveActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#182C1D"/>
            <Setter Property="Foreground" Value="#4ADE80"/>
            <Setter Property="BorderBrush" Value="#285432"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#203D27"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3A7A49"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#142418"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Icon / Close Button -->
        <Style x:Key="DangerIconBtn" TargetType="Button">
            <Setter Property="Background" Value="#1C1517"/>
            <Setter Property="Foreground" Value="#A17074"/>
            <Setter Property="BorderBrush" Value="#2E1D21"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B181C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#7F2932"/>
                                <Setter Property="Foreground" Value="#FCA5A5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Text Button (Hapus) -->
        <Style x:Key="DangerTextBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#686876"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A1618"/>
                                <Setter Property="Foreground" Value="#F87171"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Frame Container (no heavy blur DropShadowEffect for crisp, low-CPU rendering) -->
    <Border Background="{StaticResource BgDark}"
            BorderBrush="#272734"
            BorderThickness="1"
            CornerRadius="16">

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Title Bar Area (Draggable) -->
            <Grid Grid.Row="0" Margin="2,0,2,12" Background="Transparent" x:Name="TitleBarArea" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#16161D" BorderBrush="#242430" BorderThickness="1" Margin="0,0,11,0">
                        <Image x:Name="HeaderIconImage" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Antigravity Hub" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                        <TextBlock x:Name="TxtStatusSummary" Text="Memuat statistik..." FontSize="11" Foreground="{StaticResource TextSub}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnToggleSettings" Style="{StaticResource WindowCtrlBtn}" Content="&#x2699;" Width="28" Height="26" FontSize="13" Margin="0,0,3,0" ToolTip="Pengaturan &amp; Opsi"/>
                    <Button x:Name="BtnSyncUsers" Style="{StaticResource WindowCtrlBtn}" Content="&#x27F3;" Width="28" Height="26" FontSize="13" Margin="0,0,3,0" ToolTip="Sinkronkan User Windows &amp; Segarkan"/>
                    <Button x:Name="BtnMinimize" Style="{StaticResource WindowCtrlBtn}" Content="&#x2014;" Width="28" Height="26" FontSize="11" Margin="0,0,3,0" ToolTip="Minimize"/>
                    <Button x:Name="BtnClose" Style="{StaticResource WindowCtrlBtn}" Content="&#x2715;" Width="28" Height="26" FontSize="11" ToolTip="Tutup"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: Global Scope Resource Stats Bar -->
            <Border Grid.Row="1" Background="{StaticResource SurfacePanel}"
                    BorderBrush="{StaticResource BorderMuted}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="10,7"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="WINDOWS" FontSize="9" FontWeight="Bold" Foreground="#52525E" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="StatTotalWindows" Text="..." FontSize="11.5" FontWeight="SemiBold" Foreground="#E4E4E7" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="RAM SCOPE" FontSize="9" FontWeight="Bold" Foreground="#52525E" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="StatTotalRam" Text="..." FontSize="11.5" FontWeight="SemiBold" Foreground="#E4E4E7" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="CPU SCOPE" FontSize="9" FontWeight="Bold" Foreground="#52525E" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="StatTotalCpu" Text="..." FontSize="11.5" FontWeight="SemiBold" Foreground="#E4E4E7" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock Text="STORAGE" FontSize="9" FontWeight="Bold" Foreground="#52525E" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="StatTotalStorage" Text="..." FontSize="11.5" FontWeight="SemiBold" Foreground="#E4E4E7" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 2: Collapsible Settings Panel -->
            <Border x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed"
                    Background="{StaticResource SurfaceCard}"
                    BorderBrush="#272734"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Format Penanda Window Antigravity" FontSize="11" FontWeight="SemiBold" Foreground="#D4D4D8" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="TitleFormatWrap" Margin="0,0,0,10">
                        <Button x:Name="FmtUName" Content="[U1: Host]" Style="{StaticResource ChipBtn}" Margin="0,0,5,5"/>
                        <Button x:Name="FmtUOnly" Content="[U1]" Style="{StaticResource ChipBtn}" Margin="0,0,5,5"/>
                        <Button x:Name="FmtParen" Content="(1)" Style="{StaticResource ChipBtn}" Margin="0,0,5,5"/>
                        <Button x:Name="FmtBracket" Content="[1]" Style="{StaticResource ChipBtn}" Margin="0,0,5,5"/>
                        <Button x:Name="FmtNone" Content="Tanpa Tag" Style="{StaticResource ChipBtn}" Margin="0,0,5,5"/>
                    </WrapPanel>

                    <TextBlock Text="Nama File Editor di Judul Window" FontSize="11" FontWeight="SemiBold" Foreground="#D4D4D8" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="EditorTitleWrap" Margin="0,0,0,10">
                        <Button x:Name="EdTitleShow" Content="Tampilkan (file - project)" Style="{StaticResource ChipBtn}" Margin="0,0,5,4"/>
                        <Button x:Name="EdTitleHide" Content="Sembunyikan (project saja)" Style="{StaticResource ChipBtn}" Margin="0,0,5,4"/>
                    </WrapPanel>

                    <TextBlock Text="Browser Pembuka Link Akun Sekunder (OAuth &amp; Web)" FontSize="11" FontWeight="SemiBold" Foreground="#D4D4D8" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="BrowserModeWrap">
                        <Button x:Name="BrwChrome" Content="Chrome Terisolasi" Style="{StaticResource ChipBtn}" Margin="0,0,5,4"/>
                        <Button x:Name="BrwBrave" Content="Brave Terisolasi" Style="{StaticResource ChipBtn}" Margin="0,0,5,4"/>
                        <Button x:Name="BrwEdge" Content="Edge Terisolasi" Style="{StaticResource ChipBtn}" Margin="0,0,5,4"/>
                        <Button x:Name="BrwHost" Content="Browser Host Default" Style="{StaticResource ChipBtn}" Margin="0,0,5,4"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Row 3: Profiles List (Scrollable) + Initial Loading State -->
            <Grid Grid.Row="3" Margin="0,0,0,12">
                <ScrollViewer x:Name="ProfilesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ProfilesContainer">
                        <!-- Dynamic profile cards -->
                    </StackPanel>
                </ScrollViewer>

                <Border x:Name="LoadingOverlay" Background="{StaticResource BgDark}" Visibility="Visible" CornerRadius="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="220">
                        <TextBlock x:Name="TxtLoadingStatus" Text="Memuat profil &amp; metrik..." FontSize="12" FontWeight="SemiBold" Foreground="#D4D4D8" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <ProgressBar IsIndeterminate="True" Height="3" Background="#1E1E26" Foreground="#4ADE80" BorderThickness="0"/>
                        <TextBlock Text="Menyiapkan data secara stabil..." FontSize="10" Foreground="#686876" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 4: Bottom Add Profile Bar -->
            <Border Grid.Row="4" Background="{StaticResource SurfaceCard}"
                    BorderBrush="{StaticResource BorderMuted}"
                    BorderThickness="1"
                    CornerRadius="11"
                    Padding="7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtNewProfileName" Grid.Column="0" Height="34"
                             Background="{StaticResource SurfaceInput}" Foreground="{StaticResource TextMain}"
                             BorderBrush="{StaticResource BorderMuted}" BorderThickness="1"
                             CaretBrush="#FFFFFF"
                             Padding="10,0" FontSize="12" VerticalContentAlignment="Center"
                             Margin="0,0,8,0">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="7"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Button x:Name="BtnAddProfile" Grid.Column="1" Style="{StaticResource PrimaryActionBtn}" Content="+ Tambah Akun"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
